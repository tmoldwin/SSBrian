    {"source": "L1_E", "target": "L1_E", "p": 0.15, "weight_dist": {"dist": "lognormal", "mu": 0.0, "sigma": 1.0}},
    {"source": "L1_E", "target": "L1_I", "p": 0.2, "weight_dist": {"dist": "lognormal", "mu": 0.0, "sigma": 0.5}},
    {"source": "L1_I", "target": "L1_E", "p": 0.15, "weight_dist": {"dist": "lognormal", "mu": 0.0, "sigma": 0.5}},
    {"source": "L1_I", "target": "L1_I", "p": 0.15, "weight_dist": {"dist": "lognormal", "mu": 0.0, "sigma": 0.5}}
  ]
}
