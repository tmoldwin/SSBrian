  "simulation_params": {
    "tau_m_ms": 20.0,
    "tau_syn_ms": 1.0,
    "R_m_Mohm": 100.0,
    "v_rest_mV": -65.0,
    "v_thresh_mV": -55.0,
    "v_reset_mV": -65.0,
    "refractory_ms": 2.0
