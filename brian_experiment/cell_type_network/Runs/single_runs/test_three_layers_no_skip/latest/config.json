    {"source": "L1_E", "target": "L1_E", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    {"source": "L1_E", "target": "L1_I", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    {"source": "L1_I", "target": "L1_E", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    {"source": "L1_I", "target": "L1_I", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    
    {"source": "L1_E", "target": "L2_E", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    {"source": "L1_E", "target": "L2_I", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    
    {"source": "L2_E", "target": "L2_E", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
