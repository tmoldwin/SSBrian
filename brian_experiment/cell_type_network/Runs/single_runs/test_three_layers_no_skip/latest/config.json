{
  "name": "test_three_layers_no_skip",
  "description": "Three layer network with no skip connections - strict hierarchy: Layer0→L1→L2→L3. Within-layer inhibition only, increased recurrent and feedforward weights.",
  "num_stimuli": 10,
  "num_epochs": 2,
  "stim_duration": 1000,
  "break_time": 50,
