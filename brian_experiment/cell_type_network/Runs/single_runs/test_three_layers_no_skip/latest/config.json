    {"source": "L2_I", "target": "L2_E", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    {"source": "L2_I", "target": "L2_I", "p": 1.0, "weight_dist": {"dist": "lognormal", "mu": 0.5, "sigma": 1.0}},
    
